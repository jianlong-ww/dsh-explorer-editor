{
  "name": "@jianlong-ww/dsh-explorer-editor",
  "version": "0.1.1",
  "description": "Monaco editor inside the DeepSeek Harness file preview: edit, highlight, and project-typed completion in place.",
  "license": "MIT",
  "author": "jianlong-ww",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianlong-ww/dsh-explorer-editor.git"
  },
  "homepage": "https://github.com/jianlong-ww/dsh-explorer-editor#readme",
  "bugs": {
    "url": "https://github.com/jianlong-ww/dsh-explorer-editor/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "monaco",
    "editor",
    "preview"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.5"
  },
  "scripts": {
    "build": "tsdown && node scripts/sync-monaco.mjs",
    "build:code": "tsdown",
    "sync:monaco": "node scripts/sync-monaco.mjs",
    "typecheck": "node scripts/gen-local-tsconfig.mjs && node scripts/typecheck.mjs",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "monaco-editor": "0.57.0",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
